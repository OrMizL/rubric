{
  "name": "@ormizl/rubric",
  "version": "0.1.0",
  "description": "Check whether a pull request's code matches what its description claims. Read-only CLI for any GitHub PR.",
  "license": "MIT",
  "author": "Or Mizrahi",
  "homepage": "https://rubric.ormiz.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrMizL/rubric.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/OrMizL/rubric/issues",
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "claude",
    "cli"
  ],
  "type": "module",
  "bin": {
    "rubric": "./dist/rubric.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rubric/core": "workspace:*"
  }
}
